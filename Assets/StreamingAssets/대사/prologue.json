{
  "defName": "prologue",
  "lines": [
    {
      "message": "링크 정상. <color=grey>아트리아 국경 관제망 접속.</color>",
      "author": "시스템",
      "duration": 3,
      "intensity": 0.4,
      "wait": 1,
      "cue": [
        { "act": "camera", "x": 0.0, "y": 0.0 }
      ]
    },
    {
      "message": "{0}, Atria Control. 17초소 구조 요청 확인했습니다.",
      "author": "아트리아 컨트롤",
      "duration": 4,
      "intensity": 0.6,
      "wait": 0,
      "cue": [
        { "act": "camera", "x": 0.5, "y": 0.5 }
      ]
    },
    {
      "message": "단독 진입은 승인 못 합니다. <color=grey>증원 배정합니다.</color>",
      "author": "아트리아 컨트롤",
      "duration": 4,
      "intensity": 0.7,
      "wait": 0
    },
    {
      "message": "아우라 2, 3. 항로 합류합니다.",
      "author": "아트리아 컨트롤",
      "duration": 3,
      "intensity": 0.7,
      "wait": 0,
      "cue": [
        {
          "act": "spawn",
          "name": "아우라 2",
          "ship": "newship",
          "team": "Ally",
          "facing": 1.0,
          "at": "player",
          "x": -420.0,
          "y": 260.0
        },
        {
          "act": "spawn",
          "name": "아우라 3",
          "ship": "newship",
          "team": "Ally",
          "facing": 1.0,
          "at": "player",
          "x": -450.0,
          "y": -260.0
        },
        { "act": "hold", "name": "아우라 2" },
        { "act": "hold", "name": "아우라 3" },
        { "act": "look", "name": "player", "at": "아우라 2", "zoom": 0.8 }
      ]
    },
    {
      "message": "아우라 2, 접촉했습니다. 편대 자리로 들어갑니다.",
      "author": "아우라 2",
      "duration": 3,
      "intensity": 0.6,
      "wait": 0,
      "cue": [
        { "act": "camera", "x": 0.3, "y": 0.3 },
        { "act": "formation", "name": "아우라 2", "at": "player", "x": -60.0, "y": 45.0 },
        { "act": "boost", "name": "아우라 2" }
      ]
    },
    {
      "message": "아우라 3도 붙었습니다. <color=grey>삼각 유지.</color>",
      "author": "아우라 3",
      "duration": 3,
      "intensity": 0.6,
      "wait": 0,
      "cue": [
        { "act": "formation", "name": "아우라 3", "at": "player", "x": -60.0, "y": -45.0 },
        { "act": "boost", "name": "아우라 3" },
        { "act": "look", "name": "아우라 2", "at": "아우라 3", "zoom": 0.7 }
      ]
    },
    {
      "message": "간격 유지하십시오. 두 척 다 {0}을 따라갑니다.",
      "author": "아트리아 컨트롤",
      "duration": 4,
      "intensity": 0.5,
      "wait": 1,
      "cue": [
        { "act": "unboost", "name": "아우라 2" },
        { "act": "unboost", "name": "아우라 3" },
        { "act": "join", "ship": "newship", "x": -60.0, "y": 45.0 },
        { "act": "join", "ship": "newship", "x": -60.0, "y": -45.0 },
        { "act": "camera", "x": 0.6, "y": 0.4 },
        { "act": "look", "name": "player", "at": "아우라 3", "zoom": 0.95 }
      ]
    },
    {
      "message": "<color=grey>Spend your ship carefully. There is no replacement.</color>",
      "author": "아트리아 컨트롤",
      "duration": 4,
      "intensity": 0.8,
      "wait": 1
    },
    {
      "message": "미확인 함선 접근. 식별 신호 없음.",
      "author": "전술",
      "duration": 3,
      "intensity": 1.0,
      "wait": 0,
      "cue": [
        {
          "act": "spawn",
          "name": "창 1",
          "ship": "lance",
          "team": "Enemy",
          "facing": -1.0,
          "at": "player",
          "x": 760.0,
          "y": 300.0
        },
        {
          "act": "spawn",
          "name": "창 2",
          "ship": "lance",
          "team": "Enemy",
          "facing": -1.0,
          "at": "player",
          "x": 790.0,
          "y": -300.0
        },
        { "act": "camera", "x": 0.2, "y": 0.2 },
        { "act": "look", "name": "창 1", "at": "창 2", "zoom": 0.7 }
      ]
    },
    {
      "message": "포문 개방. <color=grey>Battle stations.</color>",
      "author": "전술",
      "duration": 3,
      "intensity": 1.0,
      "wait": 0,
      "cue": [
        { "act": "release", "name": "아우라 2" },
        { "act": "release", "name": "아우라 3" },
        { "act": "release", "name": "창 1" },
        { "act": "release", "name": "창 2" },
        { "act": "chase", "name": "창 1", "at": "player" },
        { "act": "chase", "name": "창 2", "at": "아우라 3" },
        { "act": "boost", "name": "창 1" },
        { "act": "boost", "name": "창 2" },
        { "act": "camera", "x": 0.1, "y": 0.25 },
        { "act": "look", "name": "player", "at": "창 1", "zoom": 0.55 }
      ]
    }
  ]
}
